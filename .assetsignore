# Excluded from the Workers static-asset upload (.gitignore format).
# NOTE: assets.directory is the repo root, so anything not listed here is
# PUBLICLY SERVED. Add new non-site files to this list.

# Repo metadata
.git
.gitignore
.assetsignore
.claude
.wrangler
node_modules
wrangler.jsonc

# Docs — not part of the served site
README.md
TRANSLATING.md
ROADMAP.md
NOTICE.md
LICENSE
LICENSE-CONTENT
CNAME

# Translation tooling: prompts, source strings and model output.
# Nothing here belongs on the public site.
translation

# EPDS tooling — the epds.*.js modules ARE served; these are not.
i18n/epds/SOURCES.md
i18n/epds/verify.js
i18n/epds/extract.js
i18n/epds/extract-phq9.js

# Worker source — not a static asset
worker

# Local review UI — never part of the public site
review

# Local English editor — writes to the repo and pushes to GitHub. Serving it
# publicly would put an edit surface on the live site.
editor
